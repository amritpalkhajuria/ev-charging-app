# Copy to .env and fill in. Never commit .env

# Azure SQL Database
DB_ENGINE=mssql
DB_HOST=your-server.database.windows.net
DB_USER=your_admin_login
DB_PASSWORD=your_password
DB_NAME=your_database

# Local MySQL instead (e.g. docker-compose):
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_SSL=false

OPENCHARGEMAP_API_KEY=your_api_key
COUNTRY_CODE=GB
PORT=3000
